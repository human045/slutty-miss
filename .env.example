# Copy this file to .env and fill in your values
# Then run:  export $(cat .env | xargs)  before starting the bot

BOT_TOKEN=your_discord_bot_token_here
XAI_KEY=your_xai_grok_api_key_here
OWNER_ID=your_discord_user_id_here
FISH_KEY=your_fish_audio_api_key_here
FISH_VOICE_ID=98655a12fa944e26b274c535e5e03842

# Optional — defaults shown
XAI_MODEL=grok-3-latest
PREFIX=!
LOG_FILE=/var/log/discordbot.log
WARNS_FILE=warnings.json
TMP_DIR=/tmp/discordmusic
